<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, TreatWarningsAsErrors, and
       GenerateDocumentationFile come from Directory.Build.props. -->

  <!-- This library's half of the trim gate (halheinrich/backgammon#129):
       the assembly declares itself trim-compatible and runs the trim
       analyzer in its own build, so a reflection-serialization regression
       becomes a build error *here* (TreatWarningsAsErrors) rather than a
       publish-time warning in BgQuiz once that repo's leg flips its
       suppressions off. Per-project deliberately — the tests and benchmarks
       are not shipped surfaces. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

</Project>
