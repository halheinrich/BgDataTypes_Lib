<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, and TreatWarningsAsErrors
       come from Directory.Build.props. Doc-file generation is a shipping-
       surface concern; test members need no XML docs, so the repo-wide
       GenerateDocumentationFile=true is overridden off here. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Local-only corpus for the Too Good predicate's exercise check
       (halheinrich/backgammon#86; SPEC-scoring §3's acceptance requirement).
       Umbrella TestData contents are gitignored, so on CI or a fresh clone
       this glob matches nothing and the corpus test passes vacuously by
       design — the XgFilter_Lib.Tests linking pattern, narrowed to the one
       subtree this suite reads. -->
  <ItemGroup>
    <None Include="..\..\TestData\BgDecisionData\*.json"
          Link="TestData\BgDecisionData\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
