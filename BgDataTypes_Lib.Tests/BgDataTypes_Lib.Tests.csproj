<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings, and TreatWarningsAsErrors
       come from Directory.Build.props. Doc-file generation is a shipping-
       surface concern; test members need no XML docs, so the repo-wide
       GenerateDocumentationFile=true is overridden off here. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
    <!-- The builders consumers' tests use, used here too: this suite builds
         its records through them, so they are exercised against the real
         records and a change to a record's construction breaks one place. -->
    <ProjectReference Include="..\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="BgDataTypes_Lib.TestSupport" />
  </ItemGroup>

  <!-- The two project files the posture pins read, linked (not copied into
       source control) and staged beside the test assembly, so the pins read
       the files the projects are actually built from. Moving or renaming
       either breaks this build rather than a test at runtime. -->
  <ItemGroup>
    <None Include="..\BgDataTypes_Lib\BgDataTypes_Lib.csproj"
          Link="Posture\BgDataTypes_Lib.csproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj"
          Link="Posture\BgDataTypes_Lib.TestSupport.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Local-only corpus for the Too Good predicate's exercise check
       (halheinrich/backgammon#86; SPEC-scoring §3's acceptance requirement).
       Umbrella TestData contents are gitignored, so on CI or a fresh clone
       this glob matches nothing and the corpus test passes vacuously by
       design — the XgFilter_Lib.Tests linking pattern, narrowed to the one
       subtree this suite reads. -->
  <ItemGroup>
    <None Include="..\..\TestData\BgDecisionData\*.json"
          Link="TestData\BgDecisionData\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
