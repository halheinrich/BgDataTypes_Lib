<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullable, implicit usings, warnings-as-errors, and doc-file
       generation are repo-wide policy — see ..\Directory.Build.props. Only
       per-project decisions live here.

       What this is: the record builders, shipped for TEST projects to
       reference — this repository's and every consumer's — so a test builds a
       well-formed decision record by stating only what it cares about, and no
       test anywhere restates the records' construction. It is not a product
       assembly and not a test project: it carries no test SDK, so
       `dotnet test` does not try to run it. The BgUiPrimitives_Razor
       test-support project is the precedent it mirrors (INSTRUCTIONS.md,
       "The test-support project"). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Never part of a product. Every project that can reach a browser publish
       (BgQuiz's WebAssembly client, Extract's client, each Razor member)
       declares the browser platform, and in such a project the
       platform-compatibility analyzer reports any use of this assembly's API
       as CA1416, an error under the house TreatWarningsAsErrors. A test
       project declares no browser platform and is unaffected. Deliberately no
       IsTrimmable: trimmability is a promise about a shipped surface, and this
       assembly ships none. Pinned by TestSupportPostureTests. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.UnsupportedOSPlatformAttribute">
      <_Parameter1>browser</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The library, and nothing else: no test framework, so a consumer's test
       project keeps its own; no package at all. The builders use the
       library's public surface only — the library grants this assembly no
       internals, so a builder can do nothing a producer cannot. -->
  <ItemGroup>
    <ProjectReference Include="..\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
  </ItemGroup>

</Project>
